{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bomantle-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-01-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true
	},
	// 일일 정답 오버라이드용 KV. 미설정 시 날짜 시드 결정론으로 동작.
	// 배포 전 `wrangler kv namespace create ANSWERS` 후 id 입력.
	"kv_namespaces": [
		{
			"binding": "ANSWERS",
			"id": "2a3cd2b09d28426294afd33c6b2d8ebb",
			"remote": true
		}
	],
	// 날짜별 DO. 무료 플랜은 SQLite 클래스만 지원(new_sqlite_classes).
	// VISITS = 접속자 카운터, RESULTS = 결과 보드(백분위·순위, SQL 테이블 사용).
	"durable_objects": {
		"bindings": [
			{
				"name": "VISITS",
				"class_name": "VisitCounter"
			},
			{
				"name": "RESULTS",
				"class_name": "ResultBoard"
			}
		]
	},
	// 기존 태그는 절대 수정하지 말 것 — 새 클래스는 새 태그로만 추가한다.
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"VisitCounter"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"ResultBoard"
			]
		}
	],
	"vars": {
		"TIMEZONE": "Asia/Seoul"
	}
}